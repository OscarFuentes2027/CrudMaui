<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Crud.ViewModels"
             x:Class="Crud.UserListPage"
             Title="UserListPage">

    <ContentPage.BindingContext>
        <vm:UserViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20">
        <Label 
            Text="Lista de usuarios"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <CollectionView 
            ItemsSource="{Binding Users}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Orientation="Horizontal" Spacing="15">
                        <Label Text="{Binding Name}"  
                            VerticalOptions="Center"/>
                        <Label Text="{Binding Email}"  
                            VerticalOptions="Center"/>
                        <Label Text="{Binding Password}"  
                            VerticalOptions="Center"/>
                        <Button Text="Editar" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserViewModel}}, Path=EditTaskCommand}"
                            CommandParameter="{Binding .}"/>
                        <Button Text="Eliminar" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserViewModel}}, Path=DeleteTaskCommand}"
                            CommandParameter="{Binding .}"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Agregar Tarea" Command="{Binding AddUserCommand}" />

    </VerticalStackLayout>
</ContentPage>
