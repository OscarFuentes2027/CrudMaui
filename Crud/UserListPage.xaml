<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Crud.ViewModels"
             xmlns:models="clr-namespace:Crud.Core.Entities;assembly=Crud.Core"
             x:Class="Crud.UserListPage"
             x:DataType="vm:UserViewModel"
             Title="User List">

    <!-- Especifica el ViewModel como el DataType de la página -->
    <ContentPage.BindingContext>
        <vm:UserViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20">
        <Label 
            Text="Lista de usuarios"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!-- Define x:DataType en CollectionView -->
        <CollectionView 
            ItemsSource="{Binding Users}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Usuarios">
                    <StackLayout Padding="10" Orientation="Horizontal" Spacing="15">
                        <Label Text="{Binding Name}" VerticalOptions="Center"/>
                        <Label Text="{Binding Email}" VerticalOptions="Center"/>
                        <Label Text="{Binding Password}" VerticalOptions="Center"/>
                        <Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserViewModel}}, Path=EditUserCommand}" CommandParameter="{Binding}" />
                        <Button Text="Eliminar" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UserViewModel}}, Path=DeleteUserCommand}" CommandParameter="{Binding}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
