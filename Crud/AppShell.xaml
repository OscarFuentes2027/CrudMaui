<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Crud.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Crud"

    Shell.FlyoutBehavior="Flyout"
    Title="Crud">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Agregar"
        ContentTemplate="{DataTemplate local:NewPage1}"
        Route="NewPage1" />
    <ShellContent
        Title="Ver usuarios"
        ContentTemplate="{DataTemplate local:UserListPage}"
        Route="UserListPage" />
    <ShellContent
        Title="Publicar libros"
        ContentTemplate="{DataTemplate local:Add_Book}"
        Route="Add Book" />
    <ShellContent
        Title="Ver Libros publicados"
        ContentTemplate="{DataTemplate local:ListBooksPage}"
        Route="ListBooksPage" />

</Shell>
