<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Crud.ViewModels"
             x:Class="Crud.Add_Book"
             x:DataType="vm:BookViewModel"
             Title="Add Book">

    <ContentPage.BindingContext>
        <vm:BookViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="20">
        <!-- Campo para ingresar el título del libro -->
        <Entry Placeholder="Title" Text="{Binding CurrentBook.Titulo, Mode=TwoWay}"/>

        <!-- Campo para ingresar el género del libro -->
        <Entry Placeholder="Genre" Text="{Binding CurrentBook.Genero, Mode=TwoWay}"/>

        <!-- Campo para seleccionar la fecha de publicación del libro -->
        <DatePicker Date="{Binding CurrentBook.FechaPublicacion, Mode=TwoWay}" />

        <!-- Campo para ingresar manualmente el ID del usuario -->
        <Entry Placeholder="User ID" Text="{Binding CurrentBook.UsuarioId, Mode=TwoWay}" Keyboard="Numeric"/>

        <!-- Botón para agregar el libro -->
        <Button Text="Add Book" Command="{Binding AddBookAsyncCommand}" />
    </VerticalStackLayout>
</ContentPage>
